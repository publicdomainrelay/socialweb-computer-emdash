{
	"$schema": "./site/node_modules/wrangler/config-schema.json",
	"name": "socialweb-computer-emdash",
	"main": "./site/src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [{ "binding": "DB" }],
	"r2_buckets": [{ "binding": "MEDIA" }],
	"worker_loaders": [{ "binding": "LOADER" }],
	"triggers": { "crons": ["* * * * *"] },
	"observability": { "enabled": true },
	"vars": { "EMDASH_SITE_INTEGRATIONS": "at://did:plc:lpfuqerea3deuoyrn7ojser4/com.fedfork.exec.oauth.clientMetadata/studio" },
	"env": {
		"fedfork": {
			"name": "socialweb-computer-emdash",
			"routes": [{ "pattern": "exec.fedfork.com", "custom_domain": true }],
			"vars": {
				"EMDASH_SITE_URL": "https://exec.fedfork.com",
				"EMDASH_SITE_INTEGRATIONS": "at://did:plc:lpfuqerea3deuoyrn7ojser4/com.fedfork.exec.oauth.clientMetadata/studio"
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "socialweb-computer-emdash",
					"database_id": "89e57069-8596-4af3-ae9d-fa5fc33999b1"
				}
			],
			"r2_buckets": [{ "binding": "MEDIA", "bucket_name": "socialweb-computer-emdash-media" }],
			"kv_namespaces": [{ "binding": "SESSION", "id": "094d8b25169f4b4794a084e0d6980da8" }],
			"worker_loaders": [{ "binding": "LOADER" }]
		}
	}
}
