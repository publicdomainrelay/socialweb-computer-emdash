---
import Code from "../components/Code.astro";
import Diagram from "../components/Diagram.astro";
import { abi, sourceRecords, statusphere, verifySource } from "../diagrams";
import Guide from "../layouts/Guide.astro";

const toc = [
	{ id: "contract", label: "The contract" },
	{ id: "abi", label: "Memory ABI" },
	{ id: "rust", label: "A module in Rust" },
	{ id: "spec", label: "module.json" },
	{ id: "test", label: "Test it" },
	{ id: "publish", label: "Publish it" },
	{ id: "rounds", label: "Rounds in practice" },
	{ id: "built", label: "How our modules are built" },
	{ id: "source", label: "Source records" },
	{ id: "verify", label: "Verify a build" },
	{ id: "browser", label: "In the browser" },
	{ id: "rules", label: "Rules" },
];

const ALICE = "did:plc:lpfuqerea3deuoyrn7ojser4";
const sourceLink = (module: string) => `/source?uri=${encodeURIComponent(`at://${ALICE}/com.fedfork.exec.wasm.module/${module}`)}`;

const stepInput = `{
  "did": "did:plc:…",
  "now": "2026-11-06T12:34:56.789Z",
  "text": "hello",
  "state": null,
  "results": [{ "ok": true, "output": { "uri": "at://…", "cid": "bafy…" } }]
}`;

const stepOutput = `{
  "calls": [{ "nsid": "com.atproto.repo.createRecord", "input": { "repo": "did:plc:…", "collection": "com.example.note", "record": {} } }],
  "next": "note_done",
  "state": { "anything": "you want back next round" },
  "result": null
}`;

const cargo = `[package]
name = "note"
version = "0.1.0"
edition = "2024"
publish = false

[lib]
crate-type = ["cdylib"]

[dependencies]
abi.workspace = true
serde.workspace = true
serde_json.workspace = true`;

const rust = `use abi::{CallResult, Did, entries, first_output};
use serde::Deserialize;
use serde_json::{Value, json};

#[derive(Deserialize)]
struct Step {
    did: Did,
    now: String,
    #[serde(default)]
    text: Option<String>,
    #[serde(default)]
    results: Vec<CallResult>,
}

fn note_step(step: Step) -> Result<Value, String> {
    let text = step.text.filter(|text| !text.is_empty()).ok_or("text is required")?;
    Ok(json!({
        "calls": [{
            "nsid": "com.atproto.repo.createRecord",
            "input": {
                "repo": step.did,
                "collection": "com.example.note",
                "record": { "$type": "com.example.note", "text": text, "createdAt": step.now },
            },
        }],
        "next": "note_done",
    }))
}

fn note_done_step(step: Step) -> Result<Value, String> {
    let created = first_output(&step.results)?;
    Ok(json!({ "calls": [], "result": { "uri": created["uri"], "cid": created["cid"] } }))
}

entries!(
    note => note_step,
    note_done => note_done_step,
);`;

const spec = `{
  "name": "Note",
  "description": "Write a com.example.note record.",
  "session": "example",
  "actions": [
    {
      "entry": "note",
      "label": "Write note",
      "fields": [{ "key": "text", "label": "Text" }]
    }
  ],
  "calls": ["com.atproto.repo.createRecord"]
}`;

const test = `import assert from "node:assert/strict";
import { test } from "node:test";

import { load } from "../harness.mjs";

const { module, drive } = await load(new URL("./note.wasm", import.meta.url));

test("has no imports", () => assert.equal(WebAssembly.Module.imports(module).length, 0));

test("writes one note", () => {
  const ran = drive("note", { text: "hello" }, () => ({ ok: true, output: { uri: "at://x", cid: "bafy" } }));
  assert.equal(ran.rounds[0].calls[0].nsid, "com.atproto.repo.createRecord");
  assert.deepEqual(ran.result, { uri: "at://x", cid: "bafy" });
});`;

const build = `rustup target add wasm32-unknown-unknown
./wasm/build.sh
node --test wasm/*/test.mjs`;

const publish = `export ATPROTO_HANDLE=you.bsky.social ATPROTO_PASSWORD='your-app-password'
./scripts/publish-wasm.sh note
goat record get "at://$ATPROTO_HANDLE/com.fedfork.exec.wasm.module/note"`;

const buildScript = `#!/usr/bin/env bash
set -euo pipefail

DIR="$(cd "$(dirname "$0")" && pwd)"
CARGO_HOME="\${CARGO_HOME:-$HOME/.cargo}"
cd "$DIR"
export RUSTFLAGS="--cfg getrandom_backend=\\"unsupported\\" --remap-path-prefix=$CARGO_HOME=/cargo --remap-path-prefix=$DIR=/wasm"
cargo build --release --locked --target wasm32-unknown-unknown
for module in statusphere vibescrobble; do
	cp "target/wasm32-unknown-unknown/release/$module.wasm" "$module/$module.wasm"
done`;

const releaseProfile = `[profile.release]
opt-level = "z"
lto = true
codegen-units = 1
panic = "abort"
strip = true`;

const ourBuild = `rustc --version
# rustc 1.97.0 (2d8144b78 2026-07-07)
./wasm/build.sh
sha256sum wasm/*/*.wasm`;

const ourPublish = `export ATPROTO_HANDLE=aliceoa.bsky.social ATPROTO_PASSWORD='app-password'
./scripts/publish-records.sh
./scripts/publish-wasm.sh statusphere
./scripts/publish-wasm.sh vibescrobble`;

const manifestExample = `{
  "$type": "com.fedfork.exec.source.manifest",
  "name": "Vibescrobble",
  "language": "rust",
  "files": [
    { "path": "Cargo.toml", "file": { "uri": "at://…/com.fedfork.exec.source.file/<sha256>", "cid": "bafyrei…" } },
    { "path": "vibescrobble/src/lib.rs", "file": { "uri": "at://…/com.fedfork.exec.source.file/<sha256>", "cid": "bafyrei…" } }
  ],
  "build": {
    "tool": "cargo",
    "version": "rustc 1.97.0 (2d8144b78 2026-07-07)",
    "command": "./build.sh",
    "artifact": "vibescrobble/vibescrobble.wasm"
  },
  "output": { "sha256": "facaba4110ec5a77738955d45d3a2ed79e795f2ceedce5cb5643973045bc3e0a", "size": 129568 },
  "origin": { "repository": "https://github.com/publicdomainrelay/socialweb-computer-emdash", "commit": "df6c03d…" },
  "createdAt": "2026-11-07T08:45:00.000Z"
}`;

const verifyCommand = `./scripts/verify-source.sh aliceoa.bsky.social vibescrobble`;

const verifyResult = `{
  "built": "facaba4110ec5a77738955d45d3a2ed79e795f2ceedce5cb5643973045bc3e0a",
  "manifest": "facaba4110ec5a77738955d45d3a2ed79e795f2ceedce5cb5643973045bc3e0a",
  "published": "facaba4110ec5a77738955d45d3a2ed79e795f2ceedce5cb5643973045bc3e0a",
  "reproducible": true
}`;

const asModule = `import { Json, call, done, fail, input, next } from "./abi";
export { alloc } from "./abi";

const COLLECTION = "com.example.note";

export function note(ptr: usize, len: i32): i64 {
  const step = input(ptr, len);
  const text = step.get("text").str;
  if (text.length == 0) return fail("text is required");
  const record = Json.object()
    .set("$type", Json.string(COLLECTION))
    .set("text", Json.string(text))
    .set("createdAt", step.get("now"));
  const create = call(
    "com.atproto.repo.createRecord",
    Json.object().set("repo", step.get("did")).set("collection", Json.string(COLLECTION)).set("record", record),
  );
  return next([create], "note_done");
}

export function note_done(ptr: usize, len: i32): i64 {
  const result = input(ptr, len).get("results").at(0);
  if (!result.get("ok").bool) return fail(result.get("error").str);
  const created = result.get("output");
  return done(Json.object().set("uri", created.get("uri")).set("cid", created.get("cid")));
}`;

const ascCommand = `npx --yes --package=assemblyscript@0.28.20 asc module.ts --outFile module.wasm --runtime stub --use abort= --optimizeLevel 3 --shrinkLevel 1 --noAssert`;
---

<Guide
	title="Write a module"
	eyebrow="Guide"
	description="A module is a WebAssembly blob with a JSON ABI. It cannot reach the network. It plans XRPC calls, and the plugin makes them with your session and hands back the results."
	toc={toc}
>
	<section id="contract">
		<h2>The contract</h2>
		<p>Each exported entry takes one JSON object and returns one JSON object.</p>
		<h3>Input</h3>
		<ul>
			<li><code>did</code>: the account the run is for.</li>
			<li><code>now</code>: the current time, as ISO 8601. Modules have no clock.</li>
			<li>Your action's fields, keyed by field key.</li>
			<li><code>state</code> and <code>results</code>: what the previous round returned, and the outcome of each call it planned.</li>
		</ul>
		<Code title="input" code={stepInput} />
		<h3>Output</h3>
		<ul>
			<li><code>calls</code>: XRPC calls to make. A call with <code>input</code> is a POST; one with only <code>params</code> is a GET.</li>
			<li><code>next</code>: the entry to call with the results. Leave it out to finish.</li>
			<li><code>state</code>: any JSON, handed back next round.</li>
			<li><code>result</code>: the answer, when there is no <code>next</code>.</li>
			<li>Or <code>{"{"} "error": "…" {"}"}</code> to stop the run.</li>
		</ul>
		<Code title="output" code={stepOutput} />
	</section>

	<section id="abi">
		<h2>Memory ABI</h2>
		<p>
			The record says <code>"abi": "emdash-wasm-json-v1"</code>. The module exports <code>memory</code>, <code>alloc(len) -&gt; ptr</code> and one function per entry, <code>entry(ptr, len) -&gt; i64</code>. The high 32 bits of the result are the output pointer and the low 32 bits its length. The module imports nothing.
		</p>
		<Diagram code={abi} label="Sequence: the plugin allocates, writes input JSON, calls the entry, and reads the output JSON from the packed pointer and length." />
		<p>The <code>abi</code> crate in <code>wasm/abi</code> does all of this. You write plain functions from a <code>Deserialize</code> struct to a JSON value.</p>
	</section>

	<section id="rust">
		<h2>A module in Rust</h2>
		<p>Add a crate under <code>wasm/</code> and list it in <code>wasm/Cargo.toml</code> members.</p>
		<Code title="wasm/note/Cargo.toml" code={cargo} />
		<Code title="wasm/note/src/lib.rs" code={rust} />
		<p>
			<code>entries!</code> exports <code>alloc</code> and one function per entry. <code>Did</code> rejects anything that does not start with <code>did:</code>. <code>first_output</code> turns a failed call into an error.
		</p>
	</section>

	<section id="spec">
		<h2>module.json</h2>
		<p>
			<code>publish-wasm.sh</code> builds the record from this file. <code>session</code> is the rkey of the integration record the module runs with. <code>actions</code> become the buttons and fields on <code>/integrations</code>. <code>calls</code> is the allow-list of NSIDs.
		</p>
		<Code title="wasm/note/module.json" code={spec} />
	</section>

	<section id="test">
		<h2>Test it</h2>
		<p>
			<code>wasm/harness.mjs</code> loads a module with no imports and drives its rounds. You answer each planned call yourself, so tests need no network. Add your module's name to the loop in <code>wasm/build.sh</code>.
		</p>
		<Code title="wasm/note/test.mjs" code={test} />
		<Code code={build} />
	</section>

	<section id="publish">
		<h2>Publish it</h2>
		<p>
			The script builds every module, then writes three kinds of record to your PDS: one <code>source.file</code> per source file it has not stored before, a new <code>source.manifest</code> describing this build, and <code>at://you/com.fedfork.exec.wasm.module/note</code> with the uploaded blob, the CID of the integration named by <code>session</code>, and a <code>source</code> reference to the manifest. The module shows up on that integration's card, with a link to its source.
		</p>
		<Code code={publish} />
		<div class="callout tone-pds">
			<strong>The integration needs the scope too.</strong>
			A module allowed to call <code>createRecord</code> still fails unless your session has <code>repo:com.example.note</code>. Put it in the integration record's scope groups.
		</div>
	</section>

	<section id="rounds">
		<h2>Rounds in practice</h2>
		<p>Statusphere reads before it writes, so setting the same emoji twice makes no new record.</p>
		<Diagram code={statusphere} label="Sequence: set_status lists your latest status, set_status_write compares and creates a record only for a new emoji, set_status_done returns its URI." />
		<p>
			Source on GitHub: <a href="https://github.com/publicdomainrelay/socialweb-computer-emdash/tree/main/wasm/statusphere">wasm/statusphere</a> and <a href="https://github.com/publicdomainrelay/socialweb-computer-emdash/tree/main/wasm/vibescrobble">wasm/vibescrobble</a>. Source in the PDS: <a href={sourceLink("statusphere")}>Statusphere</a> and <a href={sourceLink("vibescrobble")}>Vibescrobble</a>.
		</p>
	</section>

	<section id="built">
		<h2>How our modules are built</h2>
		<p>
			Statusphere and Vibescrobble are crates in one Cargo workspace, <code>wasm/</code>, with the shared <code>abi</code> crate. They are compiled with <code>rustc 1.97.0</code> for <code>wasm32-unknown-unknown</code>, with the size-focused release profile below.
		</p>
		<Code title="wasm/Cargo.toml" code={releaseProfile} />
		<p>
			<code>wasm/build.sh</code> is the only build command. Rust embeds source paths in panic messages, including your home directory for crates from the registry. The script remaps <code>$CARGO_HOME</code> to <code>/cargo</code> and the workspace to <code>/wasm</code>, so the same sources give the same bytes in any directory, on any machine and in any container. Cargo's <code>trim-paths</code> would do this, but it is not stable in Cargo 1.97.
		</p>
		<Code title="wasm/build.sh" code={buildScript} />
		<Code title="build" code={ourBuild} />
		<p>Each module was published with its sources in one step:</p>
		<Code title="publish, as the test account" code={ourPublish} />
		<p>Read them back from the test account's PDS:</p>
		<ul>
			<li><a href={sourceLink("statusphere")}>Statusphere source</a></li>
			<li><a href={sourceLink("vibescrobble")}>Vibescrobble source</a></li>
		</ul>
	</section>

	<section id="source">
		<h2>Source records</h2>
		<p>
			A module's source lives in the same PDS as the module, in two record types modeled on how <a href="https://knotless.dev">knotless</a> keeps git repositories in atproto records.
		</p>
		<ul>
			<li><strong><code>com.fedfork.exec.source.file</code></strong> holds one file's contents, inline as text or as a blob. Its record key is the sha256 of the contents, so a file shared by many builds is stored once.</li>
			<li><strong><code>com.fedfork.exec.source.manifest</code></strong> is an immutable snapshot: each path with a strong reference to its file record, the build tool, compiler version, command and artifact, the sha256 and size of the output, and the commit it came from. A new build makes a new manifest.</li>
			<li><strong><code>com.fedfork.exec.wasm.module</code></strong> points at its manifest with <code>source</code>, a URI and a CID. Changing the manifest would change its CID, so the reference catches it.</li>
		</ul>
		<Diagram code={sourceRecords} label="Flowchart: a wasm.module record points at its blob, its integration record and its source manifest; the manifest points at source.file records keyed by sha256." />
		<Code title="a manifest, trimmed" code={manifestExample} />
	</section>

	<section id="verify">
		<h2>Verify a build</h2>
		<p>
			<code>scripts/verify-source.sh</code> needs only the author's handle and the module's record key. It fetches the module, the manifest and every file from the PDS. It checks each CID and each file's sha256, then writes the files to an empty directory and runs the manifest's build command. It compares the result with the manifest's output hash and with the published blob.
		</p>
		<Diagram code={verifySource} label="Flowchart: fetch records, check CIDs and sha256, write files, build in a container, compare the built hash with the manifest output and the published blob." />
		<Code code={verifyCommand} />
		<Code title="result" code={verifyResult} />
		<div class="callout tone-deny">
			<strong>The build runs code from someone's PDS.</strong>
			The script never runs it on your machine. It runs the build in Podman or Docker, in <code>rust:&lt;version&gt;</code> for Cargo builds or <code>node:24</code> for AssemblyScript.
		</div>
		<p>
			For Vibescrobble, the bytes built in a clean <code>rust:1.97.0</code> container from the PDS records alone match the manifest and the published blob.
		</p>
	</section>

	<section id="browser">
		<h2>In the browser</h2>
		<p>
			You do not need Rust to write a module. The <a href="/studio/module">module editor</a> compiles AssemblyScript in your browser with <code>asc</code> 0.28.20. The compiler and Binaryen load only on that page. It runs your entries locally, then publishes the module, its source files and its manifest in one step.
		</p>
		<p>
			Why not Rust in the browser? There is no official rustc build that runs in a browser. The closest is <a href="https://github.com/oligamiq/rubrc">rubrc</a>, a community port of rustc to WebAssembly that is still a work in progress and needs cross-origin isolation. Rust modules are compiled to <code>wasm32-unknown-unknown</code> on a machine, published with their source, and anyone can rebuild them in a container to check the bytes.
		</p>
		<p>
			Every editor module gets an <code>abi.ts</code> with the helpers. <code>Json</code> parses and builds JSON. <code>input</code> reads a step, <code>output</code> writes one, and <code>call</code> and <code>query</code> plan XRPC calls. <code>next</code> asks for another round, <code>done</code> finishes with a result, and <code>fail</code> stops with an error. Each module must also <code>export {"{"} alloc {"}"} from "./abi"</code>.
		</p>
		<Code title="module.ts" code={asModule} />
		<p>
			The manifest records the equivalent command line. It produces the same bytes as the browser, so <code>verify-source.sh</code> can rebuild an editor module in <code>node:24</code>, and the <a href="/source">source page</a> can rebuild it in your browser.
		</p>
		<Code title="build.command for editor modules" code={ascCommand} />
	</section>

	<section id="rules">
		<h2>Rules</h2>
		<ul>
			<li>8 rounds, 10 calls per round and 25 calls per run.</li>
			<li>Only NSIDs in the record's <code>calls</code> list, when it has one.</li>
			<li>The blob's sha256 must match its CID.</li>
			<li>No imports. A module that imports anything does not instantiate.</li>
			<li>Keep the blob small. Both shipped modules are under 130 KB with <code>opt-level = "z"</code> and LTO; editor modules are about 12 KB.</li>
			<li>A module cannot run with the studio session. Its <code>session</code> must name one of your integration records.</li>
		</ul>
	</section>
</Guide>
