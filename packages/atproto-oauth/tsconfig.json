{
	"compilerOptions": {
		"target": "ES2023",
		"module": "preserve",
		"moduleResolution": "bundler",
		"strict": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"lib": [
			"ES2023",
			"DOM"
		],
		"types": [
			"node"
		]
	},
	"include": [
		"src/**/*",
		"tests/**/*",
		"testing.ts"
	]
}
