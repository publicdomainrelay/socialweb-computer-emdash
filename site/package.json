{
  "name": "site",
  "version": "0.0.3",
  "private": true,
  "type": "module",
  "emdash": {
    "label": "Starter",
    "seed": "seed/seed.json"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "start": "node ./dist/server/entry.mjs",
    "typecheck": "astro check",
    "build:cloudflare": "EMDASH_TARGET=cloudflare astro build",
    "deploy": "pnpm build:cloudflare && env -u CLOUDFLARE_ENV wrangler deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.6",
    "@astrojs/node": "^11.1.5",
    "@astrojs/react": "^7.0.0",
    "@atcute/identity": "2.0.2",
    "@atcute/identity-resolver": "2.0.3",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@emdash-cms/cloudflare": "^1.4.0",
    "@emdash-cms/sandbox-workerd": "^0.9.6",
    "@lezer/highlight": "1.2.5",
    "@publicdomainrelay/auth-atproto-subscriber": "0.1.0",
    "assemblyscript": "0.28.20",
    "astro": "^7.3.2",
    "atproto-integrations-emdash": "workspace:*",
    "codemirror": "^6.0.2",
    "emdash": "^1.3.0",
    "pele": "^1.13.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "workerd": "^1.20261104.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@cloudflare/workers-types": "^5.20261104.1",
    "@types/node": "^26.6.6",
    "typescript": "^5.9.3",
    "wrangler": "^4.158.0"
  },
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.12.0",
      "onFail": "download"
    }
  }
