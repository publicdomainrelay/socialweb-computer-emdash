{
	"lexicon": 1,
	"id": "com.fedfork.exec.oauth.clientMetadata",
	"defs": {
		"main": {
			"type": "record",
			"key": "any",
			"description": "OAuth client metadata template for an integration. A site acting as this client rebases every URL on the template origin onto its own origin and serves the result as its own client metadata document.",
			"record": {
				"type": "object",
				"required": ["name", "clientMetadata", "createdAt"],
				"properties": {
					"name": { "type": "string", "maxLength": 640, "maxGraphemes": 64 },
					"description": { "type": "string", "maxLength": 3000, "maxGraphemes": 300 },
					"clientMetadata": { "type": "ref", "ref": "#clientMetadata" },
					"scopeGroups": {
						"type": "array",
						"maxLength": 64,
						"description": "Optional subsets of the declared scope that a user can grant progressively.",
						"items": { "type": "ref", "ref": "#scopeGroup" }
					},
					"createdAt": { "type": "string", "format": "datetime" }
				}
			}
		},
		"clientMetadata": {
			"type": "object",
			"required": ["client_id", "redirect_uris", "scope"],
			"properties": {
				"client_id": { "type": "string", "format": "uri" },
				"client_name": { "type": "string", "maxLength": 640 },
				"client_uri": { "type": "string", "format": "uri" },
				"logo_uri": { "type": "string", "format": "uri" },
				"tos_uri": { "type": "string", "format": "uri" },
				"policy_uri": { "type": "string", "format": "uri" },
				"redirect_uris": { "type": "array", "items": { "type": "string", "format": "uri" } },
				"scope": { "type": "string", "maxLength": 20000 },
				"grant_types": { "type": "array", "items": { "type": "string" } },
				"response_types": { "type": "array", "items": { "type": "string" } },
				"application_type": { "type": "string" },
				"token_endpoint_auth_method": { "type": "string" },
				"dpop_bound_access_tokens": { "type": "boolean" }
			}
		},
		"scopeGroup": {
			"type": "object",
			"required": ["key", "label", "scopes"],
			"properties": {
				"key": { "type": "string", "maxLength": 64 },
				"label": { "type": "string", "maxLength": 640, "maxGraphemes": 64 },
				"scopes": { "type": "array", "maxLength": 128, "items": { "type": "string", "maxLength": 2048 } }
			}
		}
	}
}
