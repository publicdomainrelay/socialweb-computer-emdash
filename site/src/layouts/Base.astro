---
import AtmosphereSignOut from "@publicdomainrelay/auth-atproto-subscriber/AtmosphereSignOut.astro";
import { createPublicPageContext } from "emdash/page";
import { EmDashBodyEnd, EmDashBodyStart, EmDashHead } from "emdash/ui";
import SourceLink from "../components/SourceLink.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import { repository } from "../deploy";
import { guides } from "../guides";
import "../styles/site.css";

interface Props {
	title?: string;
	description?: string;
}

const { title, description } = Astro.props;
const siteTitle = new URL(process.env.EMDASH_SITE_URL || Astro.url.origin).host;
const fullTitle = title ? `${title} · ${siteTitle}` : siteTitle;
const page = createPublicPageContext({ Astro, kind: "custom", pageType: "website", title: fullTitle, pageTitle: title ?? siteTitle, description, siteName: siteTitle });
const user = Astro.locals.user;
const current = (path: string) => (Astro.url.pathname.startsWith(path) ? "page" : undefined);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<title>{fullTitle}</title>
		<script is:inline>
			document.documentElement.classList.add("js");
			try {
				const theme = localStorage.getItem("theme");
				if (theme === "light" || theme === "dark") document.documentElement.dataset.theme = theme;
			} catch {}
		</script>
		<EmDashHead page={page} />
	</head>
	<body>
		<EmDashBodyStart page={page} />
		<header class="site-header">
			<div class="frame site-header__inner">
				<a class="site-title" href="/">{siteTitle}</a>
				<nav class="site-nav" id="site-nav" aria-label="Primary">
					{
						guides.map((guide) => (
							<a href={guide.href} aria-current={current(guide.href)}>
								{guide.title}
							</a>
						))
					}
					<a href="/integrations" aria-current={current("/integrations")}>Integrations</a>
					<a href="/studio" aria-current={current("/studio")}>Studio</a>
					<div class="site-nav__extras">
						<SourceLink label="Source code" />
						<ThemeToggle />
					</div>
				</nav>
				<div class="site-actions">
					<SourceLink label="Source" />
					<ThemeToggle />
					{(user?.role ?? 0) >= 20 && <a class="site-actions__link" href="/_emdash/admin">Admin</a>}
					{
						user ? (
							<>
								<span class="site-user" title={user.email}>{user.name ?? "Account"}</span>
								<AtmosphereSignOut returnTo="/integrations" class="btn btn--ghost" />
							</>
						) : (
							<a class="btn" href="/integrations">Sign in</a>
						)
					}
					<button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Menu" data-menu-toggle>
						<span class="menu-toggle__bars" aria-hidden="true"></span>
					</button>
				</div>
			</div>
		</header>
		<main>
			<slot />
		</main>
		<footer class="site-footer">
			<div class="frame site-footer__inner">
				<p>EmDash with atproto integrations and sandboxed WebAssembly.</p>
				<p>
					<a href={repository}>Source code</a>
					<a href="https://github.com/publicdomainrelay/emdash/tree/wasm-blob-sandbox">EmDash fork</a>
					<a href="https://www.npmjs.com/package/@publicdomainrelay/auth-atproto-subscriber">Login provider</a>
					<a href="https://pele.run">Diagrams by Pele</a>
				</p>
			</div>
		</footer>
		<EmDashBodyEnd page={page} />
		<script>
			const header = document.querySelector<HTMLElement>(".site-header");
			const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
			const setOpen = (open: boolean) => {
				header?.classList.toggle("is-open", open);
				toggle?.setAttribute("aria-expanded", String(open));
				toggle?.setAttribute("aria-label", open ? "Close menu" : "Menu");
			};
			toggle?.addEventListener("click", () => setOpen(toggle.getAttribute("aria-expanded") !== "true"));
			document.addEventListener("keydown", (event) => {
				if (event.key === "Escape" && header?.classList.contains("is-open")) {
					setOpen(false);
					toggle?.focus();
				}
			});
			window.matchMedia("(min-width: 64.0625rem)").addEventListener("change", (event) => {
				if (event.matches) setOpen(false);
			});
		</script>
	</body>
</html>
