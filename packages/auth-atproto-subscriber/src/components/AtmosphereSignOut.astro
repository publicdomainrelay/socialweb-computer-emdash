---
interface Props {
	returnTo?: string;
	label?: string;
	class?: string;
}

const { returnTo = Astro.url.pathname, label = "Sign out", class: className } = Astro.props;
---

<button type="button" class={className} data-atmosphere-signout data-return-to={returnTo}>{label}</button>

<script>
	for (const button of document.querySelectorAll<HTMLButtonElement>("[data-atmosphere-signout]")) {
		button.addEventListener("click", async () => {
			button.disabled = true;
			await fetch("/_emdash/api/auth/logout", { method: "POST", headers: { "X-EmDash-Request": "1" } }).catch(() => undefined);
			window.location.assign(button.dataset.returnTo ?? "/");
		});
	}
</script>
