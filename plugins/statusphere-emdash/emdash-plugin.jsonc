{
	"$schema": "./node_modules/@emdash-cms/plugin-cli/schemas/emdash-plugin.schema.json",
	"slug": "statusphere",
	"publisher": "did:plc:5svqtrhheairglgiiyvutzik",
	"license": "MIT",
	"author": { "name": "John Andersen" },
	"security": { "email": "johnandersenpdx@gmail.com" },
	"name": "Statusphere",
	"description": "Post xyz.statusphere.status records from EmDash with progressive OAuth scopes.",
	"keywords": ["atproto", "oauth", "statusphere"],
	"capabilities": ["network:request:unrestricted", "content:read"],
	"allowedHosts": [],
	"storage": {
		"statuses": { "indexes": ["createdAt"] }
	},
	"admin": {
		"pages": [
			{ "path": "/status", "label": "Statusphere", "icon": "user" },
			{ "path": "/connect", "label": "Statusphere account", "icon": "link" }
		],
		"settingsSchema": {
			"session": { "type": "secret", "label": "OAuth session", "description": "Managed by the Connect page" },
			"pending": { "type": "secret", "label": "Pending OAuth request", "description": "Managed by the Connect page" },
			"publishEmoji": { "type": "string", "label": "Status on publish", "default": "" }
		}
	}
}
