---
interface Props {
	returnTo?: string;
	label?: string;
	placeholder?: string;
	class?: string;
	inputClass?: string;
	buttonClass?: string;
}

const {
	returnTo = Astro.url.pathname,
	label = "Sign in",
	placeholder = "you.bsky.social",
	class: className,
	inputClass,
	buttonClass,
} = Astro.props;
---

<form class:list={["atmosphere-signin", className]} data-atmosphere-signin data-return-to={returnTo}>
	<label class="atmosphere-signin__label">
		<span class="atmosphere-signin__sr">Atmosphere handle</span>
		<input class={inputClass} name="handle" placeholder={placeholder} autocomplete="username" required />
	</label>
	<button class={buttonClass} type="submit">{label}</button>
	<p class="atmosphere-signin__error" role="alert" hidden></p>
</form>

<script>
	for (const form of document.querySelectorAll<HTMLFormElement>("[data-atmosphere-signin]")) {
		const error = form.querySelector<HTMLElement>(".atmosphere-signin__error");
		form.addEventListener("submit", async (event) => {
			event.preventDefault();
			const button = form.querySelector("button");
			if (button) button.disabled = true;
			const query = new URLSearchParams({ returnTo: form.dataset.returnTo ?? "/" });
			const response = await fetch(`/_emdash/api/auth/atproto/login?${query}`, {
				method: "POST",
				headers: { "Content-Type": "application/json", "X-EmDash-Request": "1" },
				body: JSON.stringify({ handle: String(new FormData(form).get("handle") ?? "").trim() }),
			}).catch(() => undefined);
			const body = response ? await response.json().catch(() => ({})) : {};
			if (body.data?.url) {
				window.location.href = body.data.url;
				return;
			}
			if (button) button.disabled = false;
			if (error) {
				error.textContent = body.error?.message ?? "Sign in failed";
				error.hidden = false;
			}
		});
	}
</script>

<style>
	.atmosphere-signin {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
	.atmosphere-signin__label {
		display: flex;
		flex: 1;
		min-width: 12rem;
	}
	.atmosphere-signin__label input {
		flex: 1;
		min-width: 0;
	}
	.atmosphere-signin__sr {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}
	.atmosphere-signin__error {
		flex-basis: 100%;
		margin: 0;
		color: light-dark(#b91c1c, #fca5a5);
	}
</style>
