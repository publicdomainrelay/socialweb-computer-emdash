{
	"compilerOptions": {
		"target": "ES2023",
		"module": "preserve",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"strict": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"lib": ["ES2023", "DOM"],
		"types": ["node", "emdash/locals"]
	},
	"include": ["src/**/*.ts", "src/**/*.tsx", "tests/**/*.ts"]
}
