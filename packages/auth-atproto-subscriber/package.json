{
	"name": "auth-atproto-subscriber",
	"version": "0.1.0",
	"description": "Identity-only Atmosphere login for EmDash sites: atproto scope, open Subscriber signup, return-to, and drop-in Astro sign-in and sign-out components.",
	"license": "MIT",
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./admin": "./src/admin.tsx",
		"./routes/*": "./src/routes/*",
		"./AtmosphereSignIn.astro": "./src/components/AtmosphereSignIn.astro",
		"./AtmosphereSignOut.astro": "./src/components/AtmosphereSignOut.astro"
	},
	"files": [
		"src",
		"LICENSE"
	],
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"@atcute/identity-resolver": "^2.0.3",
		"@atcute/lexicons": "^2.1.1",
		"@atcute/oauth-node-client": "^2.0.1",
		"@emdash-cms/auth": "1.4.0",
		"kysely": "^0.29.8"
	},
	"devDependencies": {
		"@cloudflare/kumo": "^2.17.0",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"astro": "^7.4.7",
		"emdash": "^1.4.0",
		"react": "19.2.4",
		"typescript": "^7.0.2",
		"vitest": "^4.1.12"
	},
	"peerDependencies": {
		"@cloudflare/kumo": "*",
		"astro": ">=5",
		"emdash": ">=1.4.0",
		"react": ">=18"
	}
}
