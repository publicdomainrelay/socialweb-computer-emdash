---
import AtmosphereSignOut from "@publicdomainrelay/auth-atproto-subscriber/AtmosphereSignOut.astro";
import { createPublicPageContext } from "emdash/page";
import { EmDashBodyEnd, EmDashBodyStart, EmDashHead } from "emdash/ui";
import ThemeToggle from "../components/ThemeToggle.astro";
import { repository } from "../deploy";
import { guides } from "../guides";
import "../styles/site.css";

interface Props {
	title?: string;
	description?: string;
}

const { title, description } = Astro.props;
const siteTitle = new URL(process.env.EMDASH_SITE_URL || Astro.url.origin).host;
const fullTitle = title ? `${title} · ${siteTitle}` : siteTitle;
const page = createPublicPageContext({ Astro, kind: "custom", pageType: "website", title: fullTitle, pageTitle: title ?? siteTitle, description, siteName: siteTitle });
const user = Astro.locals.user;
const current = (path: string) => (Astro.url.pathname.startsWith(path) ? "page" : undefined);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{fullTitle}</title>
		<script is:inline>
			try {
				const theme = localStorage.getItem("theme");
				if (theme === "light" || theme === "dark") document.documentElement.dataset.theme = theme;
			} catch {}
		</script>
		<EmDashHead page={page} />
	</head>
	<body>
		<EmDashBodyStart page={page} />
		<header class="site-header">
			<div class="frame site-header__inner">
				<a class="site-title" href="/">{siteTitle}</a>
				<nav class="site-nav" aria-label="Primary">
					{
						guides.map((guide) => (
							<a href={guide.href} aria-current={current(guide.href)}>
								{guide.title}
							</a>
						))
					}
					<a href="/integrations" aria-current={current("/integrations")}>Integrations</a>
				</nav>
				<div class="site-actions">
					<a class="source-link" href={repository} aria-label="Source code on GitHub">
						<svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true" fill="currentColor">
							<path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" />
						</svg>
						<span>Source</span>
					</a>
					<ThemeToggle />
					{(user?.role ?? 0) >= 20 && <a class="site-actions__link" href="/_emdash/admin">Admin</a>}
					{
						user ? (
							<>
								<span class="site-user" title={user.email}>{user.name ?? "Account"}</span>
								<AtmosphereSignOut returnTo="/integrations" class="btn btn--ghost" />
							</>
						) : (
							<a class="btn" href="/integrations">Sign in</a>
						)
					}
				</div>
			</div>
		</header>
		<main>
			<slot />
		</main>
		<footer class="site-footer">
			<div class="frame site-footer__inner">
				<p>EmDash with atproto integrations and sandboxed WebAssembly.</p>
				<p>
					<a href={repository}>Source code</a>
					<a href="https://github.com/publicdomainrelay/emdash/tree/wasm-blob-sandbox">EmDash fork</a>
					<a href="https://www.npmjs.com/package/@publicdomainrelay/auth-atproto-subscriber">Login provider</a>
					<a href="https://pele.run">Diagrams by Pele</a>
				</p>
			</div>
		</footer>
		<EmDashBodyEnd page={page} />
	</body>
</html>
